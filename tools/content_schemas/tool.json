{
	"schema_version": 1,
	"description": "A tool the player carries and breaches with (M6 spec claim 9): the tool class it breaches as, tags, and stats (its noise, in millimetres, is how far a breach carries before the piece's breach_noise scales it).",
	"properties": {
		"schema_version": {
			"type": "int",
			"min": 1,
			"max": 1
		},
		"description": {
			"type": "string",
			"min_length": 1,
			"max_length": 240
		},
		"tool_class": {
			"type": "string",
			"ref": "tool_class"
		},
		"tags": {
			"type": "array",
			"max_length": 16,
			"items": {
				"type": "string",
				"pattern": "[a-z0-9][a-z0-9_.]*"
			}
		},
		"stats": {
			"type": "array",
			"max_length": 32,
			"items": {
				"type": "object",
				"properties": {
					"stat": {
						"type": "string",
						"ref": "stat"
					},
					"value": {
						"type": "int",
						"min": -1000000000,
						"max": 1000000000
					}
				},
				"required": [
					"stat",
					"value"
				],
				"additional_properties": false
			}
		}
	},
	"required": [
		"schema_version",
		"description",
		"tool_class",
		"tags",
		"stats"
	],
	"additional_properties": false
}
