{
	"schema_version": 1,
	"description": "A wieldable tool (M6 spec claim 4): the tool class it breaches with, and its tags.",
	"properties": {
		"schema_version": {"type": "int", "min": 1, "max": 1},
		"description": {"type": "string", "min_length": 1, "max_length": 240},
		"tool_class": {"type": "string", "ref": "tool_class"},
		"tags": {"type": "array", "max_length": 16, "items": {"type": "string", "pattern": "[a-z0-9][a-z0-9_.]*"}}
	},
	"required": ["schema_version", "description", "tool_class", "tags"],
	"additional_properties": false
}
