		"description": {
			"type": "string",
			"min_length": 1,
			"max_length": 240
		},
		"combat_profile": {
			"type": "string",
			"ref": "combat_profile"
		},
		"perception_profile": {
			"type": "string",
			"ref": "perception_profile"
		},
		"aim_profile": {
			"type": "string",
			"ref": "aim_profile"
		}
	},
	"required": [
		"schema_version",
		"description",
		"combat_profile",
		"perception_profile",
		"aim_profile"
	],
	"additional_properties": false
