{
	"schema_version": 1,
	"description": "A perk node: prerequisites, cost in skill points, and the modifiers it adds to the actor (design doc §10.3). Numbers in a file; no perk is code.",
	"properties": {
		"schema_version": {"type": "int", "min": 1, "max": 1},
		"description": {"type": "string", "min_length": 1, "max_length": 240},
		"skill": {"type": "string", "ref": "skill"},
		"prerequisites": {"type": "object", "properties": {
			"level": {"type": "int", "min": 0, "max": 100},
			"perks": {"type": "array", "max_length": 16, "items": {"type": "string", "ref": "perk"}}},
			"required": ["level", "perks"], "additional_properties": false},
		"cost": {"type": "int", "min": 0, "max": 100},
		"tags": {"type": "array", "max_length": 16, "items": {"type": "string", "pattern": "[a-z0-9][a-z0-9_.]*"}},
		"modifiers": {"type": "array", "min_length": 1, "max_length": 32, "items": {"type": "object",
			"properties": {"stat": {"type": "string", "ref": "stat"}, "class": {"type": "string", "pattern": "[a-z0-9][a-z0-9_.]*"}, "value": {"type": "int", "min": -1000000000, "max": 1000000000}},
			"required": ["stat", "class", "value"], "additional_properties": false}}
	},
	"required": ["schema_version", "description", "skill", "prerequisites", "cost", "tags", "modifiers"],
	"additional_properties": false
}
