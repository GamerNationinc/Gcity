{
	"schema_version": 1,
	"description": "A placeable build piece: its kind, its material, the cost of passing through it if it is an opening, and its value if it is a raid target (M3 spec claims 1, 6, 8).",
	"properties": {
		"schema_version": {"type": "int", "min": 1, "max": 1},
		"description": {"type": "string", "min_length": 1, "max_length": 240},
		"kind": {"type": "string", "ref": "piece_kind"},
		"material": {"type": "string", "ref": "material"},
		"open_cost": {"type": "int", "min": 0, "max": 1000000000},
		"value": {"type": "int", "min": 0, "max": 1000000000}
	},
	"required": ["schema_version", "description", "kind", "material", "open_cost", "value"],
	"additional_properties": false
}
