{
	"schema_version": 1,
	"description": "A skill: which events credit it (with a tag filter and an amount), its level thresholds, and the perk points a level grants (design doc §10.1).",
	"properties": {
		"schema_version": {"type": "int", "min": 1, "max": 1},
		"description": {"type": "string", "min_length": 1, "max_length": 240},
		"xp": {"type": "array", "min_length": 1, "max_length": 32, "items": {"type": "object",
			"properties": {
				"event": {"type": "string", "pattern": "[a-z0-9][a-z0-9_.]*"},
				"credit": {"type": "string", "pattern": "[a-z_]+"},
				"tags_any": {"type": "array", "max_length": 16, "items": {"type": "string", "pattern": "[a-z0-9][a-z0-9_.]*"}},
				"amount": {"type": "int", "min": 1, "max": 1000000}},
			"required": ["event", "credit", "tags_any", "amount"], "additional_properties": false}},
		"levels": {"type": "array", "min_length": 2, "max_length": 100, "items": {"type": "int", "min": 0, "max": 1000000000}},
		"points_per_level": {"type": "int", "min": 0, "max": 100}
	},
	"required": ["schema_version", "description", "xp", "levels", "points_per_level"],
	"additional_properties": false
}
