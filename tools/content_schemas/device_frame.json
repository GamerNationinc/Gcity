{
	"schema_version": 1,
	"description": "The personal device as an item with bays and stats (design doc §12.2; M5 spec claim 1). Numbers are integers in milli-units.",
	"properties": {
		"schema_version": {
			"type": "int",
			"min": 1,
			"max": 1
		},
		"description": {
			"type": "string",
			"min_length": 1,
			"max_length": 240
		},
		"sockets": {
			"type": "array",
			"min_length": 0,
			"max_length": 16,
			"items": {
				"type": "string",
				"ref": "device_socket"
			}
		},
		"tags": {
			"type": "array",
			"max_length": 16,
			"items": {
				"type": "string",
				"pattern": "[a-z0-9][a-z0-9_.]*"
			}
		},
		"stats": {
			"type": "array",
			"max_length": 32,
			"items": {
				"type": "object",
				"properties": {
					"stat": {
						"type": "string",
						"ref": "stat"
					},
					"value": {
						"type": "int",
						"min": -1000000000,
						"max": 1000000000
					}
				},
				"required": [
					"stat",
					"value"
				],
				"additional_properties": false
			}
		}
	},
	"required": [
		"schema_version",
		"description",
		"sockets",
		"tags",
		"stats"
	],
	"additional_properties": false
}
