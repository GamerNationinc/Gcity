# Godot import cache and editor state
.godot/
*.tmp

# Pinned engine download (tools/godot.sh)
.cache/

# Test and tool output
tests/out/
__pycache__/
*.pyc

# Engine import by-products under docs/ (a CSV there would become a .translation);
# the results folders also carry a .gdignore so the importer skips them.
docs/**/*.translation
docs/**/*.import

# Export output (tools/export.sh)
build/
# GodotSteam binaries: installed by tools/godotsteam.sh from the pinned, hash-checked release
addons/godotsteam/linux64/
addons/godotsteam/win64/
addons/godotsteam/.installed-*
# Native terrain mesher: built by tools/build_native.sh from native/terrain_mesher
native/terrain_mesher/target/
addons/terrain_mesher/
