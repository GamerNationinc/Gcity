# Godot import cache and editor state
.godot/
*.tmp

# Pinned engine download (tools/godot.sh)
.cache/

# Test and tool output
tests/out/
__pycache__/
*.pyc

# Engine import by-products under docs/ (a CSV there would become a .translation);
# the results folders also carry a .gdignore so the importer skips them.
docs/**/*.translation
docs/**/*.import
