+## Every frame over budget, and the 60 slowest, with everything recorded about it and the
+## frame before it: where the time went, what churned, whether a dig landed.
+func _worst_frames() -> Array:
+	var idx: Array[int] = []
+	for i: int in _frame_ms.size():
+		idx.append(i)
+	idx.sort_custom(func(a: int, b: int) -> bool: return _frame_ms[a] > _frame_ms[b])
+	var out: Array = []
+	for k: int in idx.size():
+		var i: int = idx[k]
+		if k >= 60 and _frame_ms[i] <= BUDGET_MS:
+			break
+		if out.size() >= 400:
+			break
+		out.append({"i": i, "t_s": _frame_t[i], "ms": _frame_ms[i], "prev_ms": _frame_ms[i - 1] if i > 0 else 0.0,
+			"script_us": _frame_script_us[i], "upload_us": _frame_upload_us[i], "chunks": _frame_chunks[i],
+			"nodes_made": _frame_nodes_made[i], "nodes_freed": _frame_nodes_freed[i],
+			"cpu_render_ms": _frame_cpu_render_ms[i], "gpu_render_ms": _frame_gpu_render_ms[i],
+			"static_mb": _frame_static_mb[i], "edit": _frame_edit[i] == 1,
+			"prev_nodes_freed": _frame_nodes_freed[i - 1] if i > 0 else 0})
+	return out
+
