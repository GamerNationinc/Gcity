; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Gcity"
config/description="Cyberpunk survival immersive-sim for the Steam Deck. See docs/gcity-design.md."
run/main_scene="res://client/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[debug]

; Engineering standards §3.7: typed GDScript everywhere; untyped declarations fail CI.
; The engine's own analyzer is the single source of truth for this rule.
gdscript/warnings/treat_warnings_as_errors=true
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2

[display]

; Steam Deck native resolution (design doc §2).
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[physics]

; Must equal SimRoot.TICK_HZ; LocalHost asserts this at startup (ADR-002, proposed).
common/physics_ticks_per_second=40
