extends GcityTest

## The M6 replay fixtures (spec claim 20) on Cold Storage, generated by
## tools/make_m6_fixtures.gd. Each is replayed here with its bus events logged, so
## what the fixture claims (an alarm or none, a door opened, a payout) is asserted on
## what happened, and its end state must hash to the recorded value.

const PLAYER: int = 1

var _sim: SimRoot
var _events: Array[Dictionary] = []


func _replay(name: String) -> void:
	var path: String = "res://tests/replay/%s.json" % name
	var fixture: ReplayFixture = ReplayFixture.parse(read_text(path))
	assert_true(fixture.is_valid(), "%s valid: %s" % [name, fixture.error])
	var db := ContentDb.new()
	assert_eq(ContentLoader.load_all(db), OK, "content")
	_sim = SimAssembly.build(fixture.seed, db)
	var log: Array[Dictionary] = []
	_events = log
	var bus: EventBus = SimAssembly.combat_of(_sim).events()
	for kind: StringName in [SensorSystem.EVENT_ALARM, BuildSystem.EVENT_OPENING, BuildSystem.EVENT_CHECK_FAILED, PerceptionSystem.EVENT_ALERTED,
			QuestSystem.EVENT_DELIVERED, QuestSystem.EVENT_EXFIL, ActorSystem.EVENT_DIED, ActorSystem.EVENT_RESPAWNED, CorpseSystem.EVENT_MOVED,
			RecoverySystem.EVENT_RETURNED, HackSystem.EVENT_COMPLETED, MovementSystem.EVENT_LANDED, BuildSystem.EVENT_BREACHED]:
		bus.subscribe(kind, func(p: Dictionary) -> void: log.append({"kind": kind, "tick": _sim.get_tick(), "p": p}))
	for c: SimCommand in fixture.commands:
		assert_eq(_sim.submit(c), OK, "submit")
	var rejected: int = 0
	for i: int in fixture.ticks:
		_sim.step()
	assert_eq(_sim.rejected_count(), rejected, "%s: no command was refused" % name)
	assert_false(fixture.expected_hash.is_empty(), "%s has its hash recorded" % name)
	assert_eq(_sim.state_hash(), fixture.expected_hash, "%s matches the recorded hash" % name)


func _of(kind: StringName) -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	for e: Dictionary in _events:
		if e["kind"] == kind:
			out.append(e)
	return out


func test_front_the_keycard_from_the_yard_opens_the_front_door_quietly() -> void:
	_replay("m6-front")
	var items: ItemSystem = SimAssembly.items_of(_sim)
	var carried: Array[StringName] = []
	for id: int in items.items_in(ItemSystem.inventory_of(PLAYER)):
		carried.append(items.item_template(id))
	assert_true(carried.has(&"cold_storage_keycard"), "the card came from the yard crate")
	var opened: Array[Dictionary] = _of(BuildSystem.EVENT_OPENING)
	assert_eq(opened.size(), 1, "one opening event")
	var door: Dictionary = opened[0]["p"]
	var piece: int = door["piece"]
	var open: bool = door["open"]
	assert_eq(SimAssembly.build_of(_sim).template_of(piece), &"cold_storage_door", "the front door")
	assert_true(open, "opened")
	assert_eq(_of(BuildSystem.EVENT_CHECK_FAILED).size(), 0, "the heat check passed")
	assert_eq(_of(SensorSystem.EVENT_ALARM).size(), 0, "and no alarm was raised")
	assert_true(SimAssembly.standing_of(_sim).standing_of(PLAYER, &"heat") <= 300, "heat stayed at or under the door's 300")


func test_side_the_monitor_is_spoofed_the_window_cut_and_no_alarm() -> void:
	_replay("m6-side")
	var hacks: Array[Dictionary] = _of(HackSystem.EVENT_COMPLETED)
	assert_eq(hacks.size(), 1, "one hack completed: the junction box")
	var cut: Array[Dictionary] = _of(BuildSystem.EVENT_BREACHED)
	assert_eq(cut.size(), 1, "one piece cut: the window")
	assert_eq(_of(SensorSystem.EVENT_ALARM).size(), 0, "the spoofed monitor raised no alarm")
	var at: Vector3i = BuildSystem.cell_of(SimAssembly.actors_of(_sim).position_of(PLAYER))
	assert_eq(at, Vector3i(49, 1, 1), "the player stands inside the maintenance window, on storey 1")
