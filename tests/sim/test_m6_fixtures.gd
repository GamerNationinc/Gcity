extends GcityTest

## The M6 replay fixtures (spec claim 20) on Cold Storage, generated by
## tools/make_m6_fixtures.gd. Each is replayed here with its bus events logged, so
## what the fixture claims (an alarm or none, a door opened, a payout) is asserted on
## what happened, and its end state must hash to the recorded value.

const PLAYER: int = 1

var _sim: SimRoot
var _events: Array[Dictionary] = []
var _commands: Array[SimCommand] = []


func _replay(name: String) -> void:
	var path: String = "res://tests/replay/%s.json" % name
	var fixture: ReplayFixture = ReplayFixture.parse(read_text(path))
	assert_true(fixture.is_valid(), "%s valid: %s" % [name, fixture.error])
	var db := ContentDb.new()
	assert_eq(ContentLoader.load_all(db), OK, "content")
	_sim = SimAssembly.build(fixture.seed, db)
	var log: Array[Dictionary] = []
	_events = log
	var bus: EventBus = SimAssembly.combat_of(_sim).events()
	for kind: StringName in [SensorSystem.EVENT_ALARM, BuildSystem.EVENT_OPENING, BuildSystem.EVENT_CHECK_FAILED, PerceptionSystem.EVENT_ALERTED,
			QuestSystem.EVENT_DELIVERED, QuestSystem.EVENT_EXFIL, ActorSystem.EVENT_DIED, ActorSystem.EVENT_RESPAWNED, CorpseSystem.EVENT_MOVED,
			RecoverySystem.EVENT_RETURNED, HackSystem.EVENT_COMPLETED, MovementSystem.EVENT_LANDED, BuildSystem.EVENT_BREACHED, CombatSystem.EVENT_HIT]:
		bus.subscribe(kind, func(p: Dictionary) -> void: log.append({"kind": kind, "tick": _sim.get_tick(), "p": p}))
	_commands = fixture.commands
	for c: SimCommand in fixture.commands:
		assert_eq(_sim.submit(c), OK, "submit")
	var rejected: int = 0
	for i: int in fixture.ticks:
		_sim.step()
	assert_eq(_sim.rejected_count(), rejected, "%s: no command was refused" % name)
	assert_false(fixture.expected_hash.is_empty(), "%s has its hash recorded" % name)
	assert_eq(_sim.state_hash(), fixture.expected_hash, "%s matches the recorded hash" % name)


func _of(kind: StringName) -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	for e: Dictionary in _events:
		if e["kind"] == kind:
			out.append(e)
	return out


func test_front_the_keycard_from_the_yard_opens_the_front_door_quietly() -> void:
	_replay("m6-front")
	var items: ItemSystem = SimAssembly.items_of(_sim)
	var carried: Array[StringName] = []
	for id: int in items.items_in(ItemSystem.inventory_of(PLAYER)):
		carried.append(items.item_template(id))
	assert_true(carried.has(&"cold_storage_keycard"), "the card came from the yard crate")
	var opened: Array[Dictionary] = _of(BuildSystem.EVENT_OPENING)
	assert_eq(opened.size(), 1, "one opening event")
	var door: Dictionary = opened[0]["p"]
	var piece: int = door["piece"]
	var open: bool = door["open"]
	assert_eq(SimAssembly.build_of(_sim).template_of(piece), &"cold_storage_door", "the front door")
	assert_true(open, "opened")
	assert_eq(_of(BuildSystem.EVENT_CHECK_FAILED).size(), 0, "the heat check passed")
	assert_eq(_of(SensorSystem.EVENT_ALARM).size(), 0, "and no alarm was raised")
	assert_true(SimAssembly.standing_of(_sim).standing_of(PLAYER, &"heat") <= 300, "heat stayed at or under the door's 300")


func test_side_the_monitor_is_spoofed_the_window_cut_and_no_alarm() -> void:
	_replay("m6-side")
	var hacks: Array[Dictionary] = _of(HackSystem.EVENT_COMPLETED)
	assert_eq(hacks.size(), 1, "one hack completed: the junction box")
	var cut: Array[Dictionary] = _of(BuildSystem.EVENT_BREACHED)
	assert_eq(cut.size(), 1, "one piece cut: the window")
	assert_eq(_of(SensorSystem.EVENT_ALARM).size(), 0, "the spoofed monitor raised no alarm")
	var at: Vector3i = BuildSystem.cell_of(SimAssembly.actors_of(_sim).position_of(PLAYER))
	assert_eq(at, Vector3i(49, 1, 1), "the player stands inside the maintenance window, on storey 1")


func test_front_hot_the_door_opens_but_the_camera_raises_the_alarm() -> void:
	_replay("m6-front-hot")
	var opened: Array[Dictionary] = _of(BuildSystem.EVENT_OPENING)
	assert_eq(opened.size(), 1, "the front door opened")
	var door_tick: int = opened[0]["tick"]
	var failed: Array[Dictionary] = _of(BuildSystem.EVENT_CHECK_FAILED)
	assert_eq(failed.size(), 1, "its heat check failed once")
	var alarms_at_door: int = 0
	for a: Dictionary in _of(SensorSystem.EVENT_ALARM):
		var p: Dictionary = a["p"]
		if a["tick"] == door_tick and p["sensor"] == &"door_camera":
			alarms_at_door += 1
	assert_eq(alarms_at_door, 1, "and the door's camera raised the alarm as it opened")
	var first_alarm: Dictionary = _of(SensorSystem.EVENT_ALARM)[0]
	var first: Dictionary = first_alarm["p"]
	assert_eq(first["sensor"], &"power_monitor", "the heat came from cutting the unspoofed window first")
	assert_true(SimAssembly.standing_of(_sim).standing_of(PLAYER, &"heat") > 300, "heat over the door's 300")



## The tick of the first command of `kind` in the fixture.
func _first_command(kind: StringName) -> int:
	for c: SimCommand in _commands:
		if c.kind == kind:
			return c.tick
	return -1


func test_hack_interrupt_a_hit_during_the_hack_loses_its_progress() -> void:
	_replay("m6-hack-interrupt")
	var started: int = _first_command(&"hack.start")
	assert_true(started > 0, "a hack was started")
	var hits_during: int = 0
	for h: Dictionary in _of(CombatSystem.EVENT_HIT):
		var p: Dictionary = h["p"]
		var tick: int = h["tick"]
		if p["target"] == PLAYER and tick > started:
			hits_during += 1
	assert_true(hits_during >= 1, "the player was hit while hacking")
	assert_eq(_of(HackSystem.EVENT_COMPLETED).size(), 0, "the hack never completed")
	assert_false(SimAssembly.hacks_of(_sim).is_hacking(PLAYER), "it stopped")
	var window: int = SimAssembly.build_of(_sim).face_piece_at(BuildSystem.face_key(Vector3i(49, 1, 1), "px"))
	assert_false(SimAssembly.sensors_of(_sim).is_spoofed(window), "the monitor is not spoofed: the progress was lost")


func test_death_the_drive_lies_in_the_body_and_the_recovery_run_delivers_it() -> void:
	_replay("m6-death")
	var deaths: Array[Dictionary] = []
	for e: Dictionary in _of(ActorSystem.EVENT_DIED):
		var p: Dictionary = e["p"]
		if p["actor"] == PLAYER:
			deaths.append(e)
	assert_eq(deaths.size(), 1, "the player died once, mid-run")
	var respawns: Array[Dictionary] = _of(ActorSystem.EVENT_RESPAWNED)
	assert_eq(respawns.size(), 1, "and woke at home once")
	var home: Dictionary = respawns[0]["p"]
	var hx: int = home["x"]
	var hy: int = home["y"]
	var hz: int = home["z"]
	var home_at: Vector3i = Vector3i(hx, hy, hz)
	assert_eq(SimAssembly.land_of(_sim).parcel_at(home_at), &"starter_plot", "on the starter plot")
	var took_back: bool = false
	for e: Dictionary in _of(CorpseSystem.EVENT_MOVED):
		var p: Dictionary = e["p"]
		var item: int = p["item"]
		var from: String = p["from"]
		if p["actor"] == PLAYER and from.begins_with("corpse.") and SimAssembly.items_of(_sim).item_template(item) == &"cold_storage_data":
			took_back = true
	assert_true(took_back, "the drive was taken back from the player's own body")
	assert_eq(_of(RecoverySystem.EVENT_RETURNED).size(), 0, "with no credits the city returned nothing")
	assert_eq(_of(QuestSystem.EVENT_EXFIL).size(), 1, "the run's exfil came after the death")
	var delivered: Array[Dictionary] = _of(QuestSystem.EVENT_DELIVERED)
	assert_eq(delivered.size(), 1, "and the contract was delivered")
	var pay: Dictionary = delivered[0]["p"]
	var credits: int = pay["credits"]
	assert_true(credits > 0, "and paid (%d credits)" % credits)
	assert_eq(SimAssembly.wallet_of(_sim).balance_of(PLAYER), credits, "into the wallet")


func test_city_death_the_city_returns_some_kit_for_a_fee() -> void:
	_replay("m6-city-death")
	var returned: Array[Dictionary] = _of(RecoverySystem.EVENT_RETURNED)
	assert_eq(returned.size(), 1, "the second death, with credits, called on the city once")
	var r: Dictionary = returned[0]["p"]
	var items: Array = r["returned"]
	var fee: int = r["fee"]
	assert_eq(fee, 100, "the content's fee")
	assert_true(items.size() >= 1, "something came home (%d items)" % items.size())
	var home: Array[int] = SimAssembly.items_of(_sim).items_in(ItemSystem.base_of(PLAYER))
	for v: Variant in items:
		var id: int = v
		assert_true(home.has(id), "item %d is in the player's base" % id)
	var paid: int = 0
	for e: Dictionary in _of(QuestSystem.EVENT_DELIVERED):
		var p: Dictionary = e["p"]
		var credits: int = p["credits"]
		paid += credits
	assert_eq(SimAssembly.wallet_of(_sim).balance_of(PLAYER), paid - fee * items.size(), "the pay less the city's fees")
	var body: StringName = SimAssembly.corpses_of(_sim).corpse_of(PLAYER)
	assert_true(SimAssembly.items_of(_sim).items_in(body).size() >= 1, "and the rest stays in the second body")
